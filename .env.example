# IOA Governance Platform — Environment Variables
# Copy this file to .env and fill in the values for your environment.
# Never commit .env — it is gitignored.

# ── Database ─────────────────────────────────────────────────────────────────
# TimescaleDB connection string (used by all services via docker-compose)
DATABASE_URL=postgresql://ioa:<password>@db:5432/ioa_governance
POSTGRES_USER=ioa
POSTGRES_PASSWORD=<password>
POSTGRES_DB=ioa_governance

# ── Authentication ────────────────────────────────────────────────────────────
# RS256 keypair for JWT signing. Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
AUTH_JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Seeded admin account (created on first startup if not already present)
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=<strong-password>

# Optional guest account (read-only; omit to disable)
AUTH_GUEST_USERNAME=guest
AUTH_GUEST_PASSWORD=<guest-password>

# ── Inter-service Security ────────────────────────────────────────────────────
# Shared secret for service-to-service calls (x-internal-service-key header).
# Must be the same value across all services. Rotate with zero-downtime
# procedure documented in docs/Security-Operations.md.
INTERNAL_SERVICE_KEY=<random-256-bit-hex>

# ── n8n Integration ───────────────────────────────────────────────────────────
# n8n Cloud or self-hosted instance REST API
N8N_BASE_URL=https://<your-instance>.app.n8n.cloud
N8N_API_KEY=<n8n-api-key>

# Webhook URL that n8n calls to trigger AI governance analysis
N8N_ANALYSIS_WEBHOOK_URL=https://<n8n-instance>/webhook/<path>

# Public base URL this platform is reachable at (for n8n → service callbacks)
CALLBACK_BASE_URL=https://ioa.yourdomain.com

# ── Kong API Gateway ──────────────────────────────────────────────────────────
# Admin API of the shared Kong instance (must already be running)
KONG_ADMIN_URL=http://kong-gateway:8001

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
