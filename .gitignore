# Secret overrides — contains API keys
docker-compose.override.yml

# decK dumps of the shared Kong instance — these are full-state snapshots
# that include OTHER TEAMS' unrelated services/routes/plugins (product,
# order, sbm, chatbot, etc.), not just this project's. They don't belong in
# this repo; kept locally only, as pre-change safety backups.
kong/backups/

# n8n CLI config — contains personal account info, cloud URLs, org IDs
.n8nac/
n8nac-config.json

# n8n workflow export — operational backup, not source code.
# Credential IDs and webhook paths baked in. Manage workflow
# definitions inside n8n directly; export separately if needed.
workflows.json

# Personal / scratch — not project source
Personal/

# Claude Code and agent context — machine-specific, not portable.
# Uses the .claude/* + re-exclude-then-negate chain (not a bare .claude/
# exclusion) because git won't apply a negation pattern to anything under a
# directory excluded via a trailing-slash pattern — it prunes traversal
# before negations are even considered.
.claude/*
!.claude/skills/
.claude/skills/*
# Exception: the /ioa skill is a shared dev tool (wraps packages/ioa-cli),
# not machine-specific config — tracked so the team gets it via git, not
# out-of-band copy/paste.
!.claude/skills/ioa/
.agents/

# RaiSE personal directory (per-developer, not shared)
.raise/rai/personal/

# CI: Node fetched into the Jenkins workspace
.node-*/
