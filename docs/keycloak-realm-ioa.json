{
  "realm": "ioa",
  "displayName": "IOA Governance Platform",
  "displayNameHtml": "<b>IOA</b> Governance Platform",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 10,

  "accessTokenLifespan": 3600,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 86400,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": false,
  "clientSessionIdleTimeout": 0,
  "clientSessionMaxLifespan": 0,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,

  "groups": [
    {
      "name": "ioa-platform-admins",
      "path": "/ioa-platform-admins",
      "attributes": {
        "ioa-role": ["platform-admin"]
      }
    },
    {
      "name": "ioa-governance-officers",
      "path": "/ioa-governance-officers",
      "attributes": {
        "ioa-role": ["governance-officer"]
      }
    },
    {
      "name": "ioa-security-reviewers",
      "path": "/ioa-security-reviewers",
      "attributes": {
        "ioa-role": ["security-reviewer"]
      }
    },
    {
      "name": "ioa-business-owners",
      "path": "/ioa-business-owners",
      "attributes": {
        "ioa-role": ["business-owner"]
      }
    },
    {
      "name": "ioa-auditors",
      "path": "/ioa-auditors",
      "attributes": {
        "ioa-role": ["auditor"]
      }
    }
  ],

  "clients": [
    {
      "clientId": "ioa-governance",
      "name": "IOA Governance Platform",
      "description": "IOA Governance Platform — enterprise auth client",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "REPLACE-WITH-GENERATED-SECRET",
      "redirectUris": [
        "http://ioa.ea2sa.com/api/auth/oidc/callback",
        "http://localhost:8000/api/auth/oidc/callback",
        "http://phoenix:8000/api/auth/oidc/callback"
      ],
      "webOrigins": [
        "http://ioa.ea2sa.com",
        "http://localhost:8000",
        "http://phoenix:8000"
      ],
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "post.logout.redirect.uris": "http://ioa.ea2sa.com/*##http://localhost:8000/*",
        "access.token.lifespan": "3600",
        "use.refresh.tokens": "true",
        "refresh.token.max.reuse": "0",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "groups",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "given name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "firstName",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "given_name",
            "jsonType.label": "String"
          }
        },
        {
          "name": "family name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "lastName",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "family_name",
            "jsonType.label": "String"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "emailVerified",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email_verified",
            "jsonType.label": "boolean"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],

  "users": [
    {
      "username": "ioa.admin",
      "email": "ioa.admin@ea2sa.com",
      "firstName": "IOA",
      "lastName": "Platform Admin",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "CHANGE-ME-DEMO-ONLY",
          "temporary": true
        }
      ],
      "groups": ["/ioa-platform-admins"],
      "attributes": {
        "department": ["Platform Engineering"]
      }
    },
    {
      "username": "alice.governance",
      "email": "alice.governance@ea2sa.com",
      "firstName": "Alice",
      "lastName": "Governance",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
