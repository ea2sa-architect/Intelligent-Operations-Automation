      }
    },
    {
      "username": "bob.reviewer",
      "email": "bob.reviewer@ea2sa.com",
      "firstName": "Bob",
      "lastName": "Reviewer",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "CHANGE-ME-DEMO-ONLY",
          "temporary": true
        }
      ],
      "groups": ["/ioa-security-reviewers"],
      "attributes": {
        "department": ["Security"]
      }
    },
    {
      "username": "carol.owner",
      "email": "carol.owner@ea2sa.com",
      "firstName": "Carol",
