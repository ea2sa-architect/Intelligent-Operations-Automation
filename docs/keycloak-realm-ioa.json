          "temporary": true
        }
      ],
      "groups": ["/ioa-business-owners"],
      "attributes": {
        "department": ["Product Engineering"]
      }
    },
    {
      "username": "dave.auditor",
      "email": "dave.auditor@ea2sa.com",
      "firstName": "Dave",
      "lastName": "Auditor",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "CHANGE-ME-DEMO-ONLY",
          "temporary": true
        }
      ],
