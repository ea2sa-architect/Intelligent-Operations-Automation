# Admin-privileged config for setup_agent.py ONLY — never loaded by
# ioa_adapter.py or the notebook itself. Keep this out of anywhere the
# running agent's own process could read it.
#
# The API key here needs user:manage (to register the agent identity and
# mint its credential) and inference:manage (to register the model) scopes
# — mint one via POST /api/auth/api-keys as a platform-admin/governance-
# officer user.

IOA_API_URL=http://localhost:8000
IOA_ADMIN_API_KEY=
