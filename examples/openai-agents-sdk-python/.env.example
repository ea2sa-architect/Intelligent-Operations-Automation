# Runtime config for the notebook / ioa_adapter.py — low-privilege only.
# Produced by setup_agent.py's printed output; never put an admin API key
# here (that belongs in .env.admin, see .env.admin.example).

IOA_API_URL=http://localhost:8000
IOA_AGENT_TOKEN=
IOA_MODEL_ID=

# Your actual OpenAI credential — unrelated to IOA, used directly by the
# openai-agents SDK.
OPENAI_API_KEY=
